[Unit]
Description=GDOU SRUN network authentication
After=network.target
ConditionPathExists=/etc/netkeeper/config.toml
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/netkeeper run --config %d/config
Restart=always
RestartPreventExitStatus=78
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=30s
TimeoutStartSec=50s
TimeoutStopSec=5s
RuntimeDirectory=netkeeper
RuntimeDirectoryMode=0755
# Keep recovery intent across process restarts, but clear it on stop and reboot.
RuntimeDirectoryPreserve=restart
# systemd reads the root-only config and supplies it to a temporary service user.
DynamicUser=yes
StateDirectory=netkeeper
StateDirectoryMode=0700
LoadCredential=config:/etc/netkeeper/config.toml
# Some kernels require this capability for SO_BINDTODEVICE.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal
