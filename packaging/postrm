#!/bin/sh
set -e

case "$1" in
    remove)
        deb-systemd-helper mask netkeeper.service >/dev/null || true
        ;;
    purge)
        deb-systemd-helper purge netkeeper.service >/dev/null || true
        deb-systemd-helper unmask netkeeper.service >/dev/null || true
        rm -f "${DPKG_ROOT:-}/run/netkeeper/status.json"
        rmdir "${DPKG_ROOT:-}/run/netkeeper" 2>/dev/null || true
        ;;
esac

case "$1" in
    remove|purge)
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload || true
        fi
        ;;
esac
